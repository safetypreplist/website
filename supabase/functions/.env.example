# Edge Function secrets — set with `supabase secrets set KEY=value`
# Never put these values in the frontend or any VITE_ variable.

# Restricted Test Mode key (rk_test_...) preferred over sk_test_...
STRIPE_SECRET_KEY=
# Signing secret from the Test webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email after verified purchase)
RESEND_API_KEY=
EMAIL_FROM=Safety Prep List <info@safetypreplist.com>

# Public site used in Stripe return URLs and emails
APP_URL=https://yourdomain.com
SUPPORT_EMAIL=info@safetypreplist.com

# Brevo mailing list for the free Emergency Documents Checklist
BREVO_API_KEY=
BREVO_LIST_ID=
