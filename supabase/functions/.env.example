# Edge Function secrets — set with `supabase secrets set KEY=value`
# Never put these values in the frontend or any VITE_ variable.

# Live: rk_live_... (preferred RAK) or sk_live_...
# Test: rk_test_... / sk_test_... — mode follows the key prefix.
STRIPE_SECRET_KEY=
# Signing secret from the webhook endpoint in the SAME mode as the secret key (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Optional price id overrides (price_... in the same mode). Prefer lookup keys when unset.
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_BASIC_ADDITIONAL=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_UPGRADE=

# Owner admin-licenses (view / revoke). Min 16 characters. Not the old account login.
ADMIN_SECRET=

# Resend (transactional email — license key delivery)
RESEND_API_KEY=
EMAIL_FROM=Safety Prep List <info@safetypreplist.com>

# Public site used in Stripe return URLs and emails
APP_URL=https://yourdomain.com
SUPPORT_EMAIL=info@safetypreplist.com

# Brevo mailing list for the free Emergency Documents Checklist (kept)
BREVO_API_KEY=
BREVO_LIST_ID=
