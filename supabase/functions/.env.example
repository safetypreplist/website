# Edge Function secrets — set with:
#   supabase secrets set PAYPAL_CLIENT_ID=...
#   supabase secrets set PAYPAL_CLIENT_SECRET=...
# Never put these values in the frontend.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live

# Resend (transactional email after verified purchase)
RESEND_API_KEY=
EMAIL_FROM=Safety Prep List <info@safetypreplist.com>

# Public site used in PayPal return URLs and emails
APP_URL=https://yourdomain.com
SUPPORT_EMAIL=info@safetypreplist.com

# Brevo mailing list for the free Emergency Documents Checklist
BREVO_API_KEY=
BREVO_LIST_ID=
