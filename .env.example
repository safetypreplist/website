# =============================================================================
# Safety Prep List — frontend environment
# Copy this file to .env.local for development.
# Never commit real secrets. GitHub Pages only receives VITE_ public values.
# =============================================================================

# Public Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key (Project Settings → API → anon public)
# Safe for the browser. Row Level Security must remain enabled.
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Public PayPal REST client ID only (Developer Dashboard → Apps → Live)
# NEVER put the PayPal secret here.
VITE_PAYPAL_CLIENT_ID=your_paypal_live_client_id

# sandbox | live  (use live for production)
VITE_PAYPAL_ENV=live

# Public site URL used in emails and redirects
VITE_APP_URL=http://localhost:5173

# Optional support contact shown in the app and purchase emails
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_SUPPORT_NAME=Safety Prep List Support

# Brevo mailing list (FREE Emergency Documents Checklist)
# Server-only. Do NOT prefix these with VITE_ — that would expose the key in the browser.
# Local: used by the Vite /api/subscribe-checklist route.
# Live site: also set these with `supabase secrets set` (see docs/EMAIL.md).
BREVO_API_KEY=
BREVO_LIST_ID=
